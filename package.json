  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.test.json",
    "test": "node --test dist-test/tests/charset.test.js dist-test/tests/analyzer.test.js dist-test/tests/extractor.test.js dist-test/tests/fixes.test.js dist-test/tests/sandbox.test.js dist-test/tests/oracle.test.js dist-test/tests/cli.test.js"
  },
  "dependencies": {
    "@eslint-community/regexpp": "^4.12.1",
    "typescript": "^5.7.3",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.19"
  }
}
