{
  "name": "@pie527645-cloud/redos-hunter",
  "version": "1.0.0",
  "description": "Static regular expression ambiguity analyzer and isolated sandbox empirical ReDoS confirmation CLI.",
  "type": "module",
  "license": "MIT",
  "author": "pie527645-cloud",
  "repository": {
    "type": "git",
    "url": "https://github.com/pie527645-cloud/redos-hunter.git"
  },
  "homepage": "https://github.com/pie527645-cloud/redos-hunter#readme",
  "bugs": {
    "url": "https://github.com/pie527645-cloud/redos-hunter/issues"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "bin": {
    "redos-hunter": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
